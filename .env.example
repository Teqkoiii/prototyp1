# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server-side access API. Keep real values in an ignored .env file or a secret manager.
API_PORT=4000
DATABASE_PATH=./data/gym.sqlite3
ACCESS_LOG_RETENTION_HOURS=4
RFID_HASH_SECRET=
DOOR_GATEWAY_SECRETS_JSON=

# Manual Gym Hub API (independent of the DHBW scanner API).
GYM_APP_API_PORT=4001
GYM_APP_DATABASE_PATH=./data/gym-app.sqlite3
GYM_MAX_CHECK_IN_HOURS=8
# Leave unset until an approved room capacity is known; availability will then be shown as unknown.
GYM_RESERVATION_CAPACITY=
# Exact origins only; for a deployed Capacitor app include its origin. Cross-origin cookies require HTTPS.
GYM_APP_ALLOWED_ORIGINS=
# Optional API URL for native builds. Leave blank for same-origin web deployment.
VITE_GYM_API_BASE_URL=
