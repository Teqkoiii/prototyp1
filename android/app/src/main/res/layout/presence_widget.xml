<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@drawable/presence_widget_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Campus Gym"
        android:textColor="#F8FAFC"
        android:textStyle="bold"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/presence_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/presence_widget_checked_out"
        android:textColor="#CBD5E1"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/check_in_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/presence_widget_check_in"
            android:textAllCaps="false"
            android:contentDescription="@string/presence_widget_check_in" />

        <Button
            android:id="@+id/check_out_button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/presence_widget_check_out"
            android:textAllCaps="false"
            android:contentDescription="@string/presence_widget_check_out" />
    </LinearLayout>
</LinearLayout>
